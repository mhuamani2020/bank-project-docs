<mxfile host="app.diagrams.net" modified="2026-10-19T00:00:00.000Z" agent="opencode" version="24.0.0" type="device">
  <diagram id="seq-wallet-async-22" name="Secuencia - Monedero Yanki (carga y retiro asincrono)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Carga y retiro de saldo asíncronos con Kafka (US-41, US-42, US-53)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="330" y="0" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l-cli" value="Cliente&lt;br/&gt;(HTTP + JWT)" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-gw" value="API Gateway&lt;br/&gt;:8089" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="255" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-ys" value="yanki-service&lt;br/&gt;:8085" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="470" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-db" value="MongoDB&lt;br/&gt;wallets + wallet_operations" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="685" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-kafka" value="Kafka&lt;br/&gt;wallet-operations / results" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-bas" value="bank-account-service&lt;br/&gt;WalletOperationConsumer" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1115" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1. POST /wallets/{id}/top-up {amount}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.12;entryX=0.5;entryY=0.12;" parent="1" source="l-cli" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2. Enrutamiento Path=/wallets/** con JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.19;entryX=0.5;entryY=0.19;" parent="1" source="l-gw" target="l-ys" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3. requireWallet (400) y valida tarjeta asociada (400 si no tiene)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.26;entryX=0.5;entryY=0.26;" parent="1" source="l-ys" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="4. Crea la operación con estado PENDING en wallet_operations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.33;entryX=0.5;entryY=0.33;" parent="1" source="l-ys" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="5. Publica WalletOperationEvent en wallet-operations (key = operationId)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.40;entryX=0.5;entryY=0.40;" parent="1" source="l-ys" target="l-kafka" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="6. 202 Accepted {operationId, status: PENDING}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.47;entryX=0.5;entryY=0.47;" parent="1" source="l-ys" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="7. JSON de la operación pendiente (el saldo aún no cambia)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.53;entryX=0.5;entryY=0.53;" parent="1" source="l-gw" target="l-cli" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="8. WalletOperationConsumer consume wallet-operations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.60;entryX=0.5;entryY=0.60;" parent="1" source="l-kafka" target="l-bas" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="9. Debita o acredita la tarjeta en bank_accounts y registra el movimiento" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.67;entryX=0.5;entryY=0.67;" parent="1" source="l-bas" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="10. Publica el resultado en wallet-operation-results (COMPLETED / FAILED)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.74;entryX=0.5;entryY=0.74;" parent="1" source="l-bas" target="l-kafka" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="11. WalletOperationResultConsumer recibe el resultado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.81;entryX=0.5;entryY=0.81;" parent="1" source="l-kafka" target="l-ys" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="12. Marca la operación y aplica balance -/+ amount en el monedero" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.88;entryX=0.5;entryY=0.88;" parent="1" source="l-ys" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="13. Operación COMPLETED / FAILED persistida en wallet_operations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.95;entryX=0.5;entryY=0.95;" parent="1" source="l-ys" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Endpoints cubiertos: POST /wallets/{id}/top-up (202 con operación PENDING / 400) y POST /wallets/{id}/withdraw (202 / 400).&lt;br/&gt;- Validaciones previas al 202: monedero existente, tarjeta de débito asociada y, en withdraw, saldo suficiente (400).&lt;br/&gt;- Si el consumidor resuelve con FAILED, la operación se guarda con errorMessage y el saldo no cambia; los errores de tópico o de monedero se registran en log.&lt;br/&gt;- Sin llamadas REST entre yanki-service y bank-account-service: toda la coordinación ocurre por los topics wallet-operations y wallet-operation-results (US-53)." style="text;html=1;align=left;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;spacing=6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="300" y="815" width="760" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>