        <mxCell id="l-cs" value="customer-service&lt;br/&gt;:8081" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="685" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-cr" value="credit-service&lt;br/&gt;:8083" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-db" value="MongoDB&lt;br/&gt;bank_account_db.bank_accounts" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1115" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1. POST /bank-accounts {customerId, accountType, balance...}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.11;entryX=0.5;entryY=0.11;" parent="1" source="l-cli" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2. Enrutamiento /bank-accounts/** con JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.16;entryX=0.5;entryY=0.16;" parent="1" source="l-gw" target="l-bas" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3. GET /customers/{id} (WebClient + CircuitBreaker, timeout 2 s)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.22;entryX=0.5;entryY=0.22;" parent="1" source="l-bas" target="l-cs" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="4. Cliente encontrado / vacío si 404 → 400 El cliente no existe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.28;entryX=0.5;entryY=0.28;" parent="1" source="l-cs" target="l-bas" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="5. GET /credits/customer/{id}/has-overdue-debt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.33;entryX=0.5;entryY=0.33;" parent="1" source="l-bas" target="l-cr" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="6. true → 400: la deuda vencida bloquea productos nuevos (US-32)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.39;entryX=0.5;entryY=0.39;" parent="1" source="l-cr" target="l-bas" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="7. Si el perfil es VIP o PYME: GET /credits/customer/{id}/has-credit-card" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.44;entryX=0.5;entryY=0.44;" parent="1" source="l-bas" target="l-cr" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="8. false → 400: debe poseer tarjeta de crédito (US-23, US-24)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.50;entryX=0.5;entryY=0.50;" parent="1" source="l-cr" target="l-bas" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="9. validateAndSave + applyProductRules (BUSINESS sin ahorro/plazo fijo; PERSONAL 1 por tipo; saldo inicial mínimo)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.56;entryX=0.5;entryY=0.56;" parent="1" source="l-bas" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="10. Cuenta guardada con id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.61;entryX=0.5;entryY=0.61;" parent="1" source="l-db" target="l-bas" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="11. 201 Created (BankAccountResponse)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.67;entryX=0.5;entryY=0.67;" parent="1" source="l-bas" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="12. JSON de la cuenta creada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.73;entryX=0.5;entryY=0.73;" parent="1" source="l-gw" target="l-cli" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="13. GET /bank-accounts/{id}/balance" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.78;entryX=0.5;entryY=0.78;" parent="1" source="l-cli" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m14" value="14. Proxy de la consulta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.84;entryX=0.5;entryY=0.84;" parent="1" source="l-gw" target="l-bas" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m15" value="15. findById → AvailableBalanceResponse (accountId, accountType, balance)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.89;entryX=0.5;entryY=0.89;" parent="1" source="l-bas" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m16" value="16. 200 con el saldo disponible / 404 si no existe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.95;entryX=0.5;entryY=0.95;" parent="1" source="l-bas" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Endpoints cubiertos: GET /bank-accounts (200), POST /bank-accounts (201 / 400 / 503), GET /bank-accounts/{id} (200 / 404), PUT /bank-accounts/{id} (200 / 404, revalida cliente y reglas), DELETE /bank-accounts/{id} (204) y GET /bank-accounts/{id}/balance (200 / 404).&lt;br/&gt;- Producto por tipo de cliente (US-06 a US-10): SAVINGS con maxMovements, CURRENT con maintenanceFee, FIXED_TERM con día de retiro; BUSINESS no puede tener ahorro ni plazo fijo y exige al menos un titular.&lt;br/&gt;- Si customer-service o credit-service fallan (timeout 2 s o Circuit Breaker abierto) el fallback devuelve 503." style="text;html=1;align=left;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;spacing=6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="300" y="815" width="760" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>