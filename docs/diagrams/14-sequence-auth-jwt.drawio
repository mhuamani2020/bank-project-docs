        <mxCell id="title" value="Autenticación y autorización con JWT: login, registro y protección de APIs (US-29, US-30, US-31)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="222" y="0" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l-cli" value="Cliente&lt;br/&gt;(Postman / app)" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="150" height="760" as="geometry" />
