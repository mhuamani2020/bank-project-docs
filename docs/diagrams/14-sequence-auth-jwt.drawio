        <mxCell id="l-gw" value="API Gateway&lt;br/&gt;:8089" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="255" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-auth" value="auth-service&lt;br/&gt;:8084" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="470" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-db" value="MongoDB&lt;br/&gt;auth_db.users" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="685" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-dest" value="Microservicio&lt;br/&gt;destino" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1. POST /auth/login {username, password}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.11;entryX=0.5;entryY=0.11;" parent="1" source="l-cli" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2. Enrutamiento Path=/auth/** → lb://AUTH-SERVICE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.17;entryX=0.5;entryY=0.17;" parent="1" source="l-gw" target="l-auth" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3. findByUsername en users y comparación con BCryptPasswordEncoder" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.23;entryX=0.5;entryY=0.23;" parent="1" source="l-auth" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="4. Usuario con hash BCrypt (si no existe o no coincide → 401)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.29;entryX=0.5;entryY=0.29;" parent="1" source="l-db" target="l-auth" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="5. JwtService firma HS256: sub, roles[], iss y exp (3600 s) → 200" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.35;entryX=0.5;entryY=0.35;" parent="1" source="l-auth" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="6. {accessToken, tokenType: Bearer, expiresIn}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.41;entryX=0.5;entryY=0.41;" parent="1" source="l-gw" target="l-cli" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="7. POST /auth/register {username, password, role}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.47;entryX=0.5;entryY=0.47;" parent="1" source="l-cli" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="8. Enrutamiento /auth/register (endpoint público)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.53;entryX=0.5;entryY=0.53;" parent="1" source="l-gw" target="l-auth" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="9. existsByUsername (400 si ya existe) + encode BCrypt + save con rol USER/ADMIN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.59;entryX=0.5;entryY=0.59;" parent="1" source="l-auth" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="10. 201 Created {id, username, role}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.65;entryX=0.5;entryY=0.65;" parent="1" source="l-auth" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="11. JSON del usuario registrado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.71;entryX=0.5;entryY=0.71;" parent="1" source="l-gw" target="l-cli" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="12. POST /bank-accounts con Authorization: Bearer &lt;token&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.77;entryX=0.5;entryY=0.77;" parent="1" source="l-cli" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="13. Enrutamiento /bank-accounts/** (solo propaga el JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.83;entryX=0.5;entryY=0.83;" parent="1" source="l-gw" target="l-dest" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m14" value="14. Resource Server valida firma, expiración y roles → 200 protegido / 401" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.89;entryX=0.5;entryY=0.89;" parent="1" source="l-dest" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m15" value="15. Respuesta JSON al cliente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.95;entryX=0.5;entryY=0.95;" parent="1" source="l-gw" target="l-cli" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Endpoints cubiertos: POST /auth/login (200 / 401 / 400) y POST /auth/register (201 / 400).&lt;br/&gt;- Usuario por defecto admin/admin123 (ADMIN) sembrado por DataInitializer; secretos y vigencia en Config Server (app.jwt.secret, app.jwt.expiration-seconds).&lt;br/&gt;- Claims del token: sub (username), roles (ROLE_*), iss (bank-system) y exp; solo access token, sin refresh.&lt;br/&gt;- /auth/login, /auth/register y /actuator/** son públicos; el resto de rutas exige JWT válido (US-31)." style="text;html=1;align=left;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;spacing=6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="192" y="815" width="760" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>