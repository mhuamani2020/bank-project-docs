<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-10-16T00:00:00.000Z" agent="opencode" version="24.0.0" type="device">
  <diagram id="seq-yanki-10" name="Secuencia - Yanki + Kafka">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Diagrama de Secuencia - Monedero Yanki y eventos Kafka (Parte III)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="220" y="0" width="760" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l-user" value="Usuario&lt;br/&gt;(App Yanki)" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="30" y="40" width="130" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-yanki" value="yanki-service&lt;br/&gt;:8085" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="270" y="40" width="140" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-db" value="MongoDB&lt;br/&gt;yanki_db" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="520" y="40" width="120" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-kafka" value="Kafka&lt;br/&gt;:9092" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="740" y="40" width="130" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-bank" value="bank-account-service&lt;br/&gt;:8082" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="960" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="1. POST /wallets (registro; no requiere ser cliente del banco)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.10;entryX=0.5;entryY=0.10;" parent="1" source="l-user" target="l-yanki" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="2. Guarda el monedero (documento, celular, IMEI, correo) y responde 201" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.17;entryX=0.5;entryY=0.17;" parent="1" source="l-yanki" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="3. POST /wallets/{id}/payments (pago a otro monedero por celular)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.24;entryX=0.5;entryY=0.24;" parent="1" source="l-user" target="l-yanki" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="4. Transfiere saldo entre monederos (síncrono, en yanki_db) y responde 200" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.31;entryX=0.5;entryY=0.31;" parent="1" source="l-yanki" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="5. POST /wallets/{id}/top-up | /withdraw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.38;entryX=0.5;entryY=0.38;" parent="1" source="l-user" target="l-yanki" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="6. Crea WalletOperation PENDING y responde 202 Accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.45;entryX=0.5;entryY=0.45;" parent="1" source="l-yanki" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="7. Publica comando {operationId, type, debitCardId, amount} en wallet-operations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.52;entryX=0.5;entryY=0.52;" parent="1" source="l-yanki" target="l-kafka" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="8. Consume wallet-operations y ejecuta contra la tarjeta de débito" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.59;entryX=0.5;entryY=0.59;" parent="1" source="l-kafka" target="l-bank" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b9" value="9. TOP_UP: debita la cuenta (DEBIT_CARD_PAYMENT). WITHDRAW: abona (DEPOSIT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;align=left;verticalAlign=bottom;exitX=0.5;exitY=0.66;entryX=0.5;entryY=0.66;" parent="1" source="l-bank" target="l-kafka" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b10" value="10. Publica WalletOperationResult (COMPLETED / FAILED) en wallet-operation-results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.73;entryX=0.5;entryY=0.73;" parent="1" source="l-kafka" target="l-yanki" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b11" value="11. Consume el resultado, ajusta el saldo (TOP_UP abona / WITHDRAW debita) y cierra la operación" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.80;entryX=0.5;entryY=0.80;" parent="1" source="l-yanki" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="Regla de la Parte III: yanki-service NO llama por REST a bank-account-service; toda la comunicación es por Kafka.&lt;br/&gt;Mensajes como JSON en texto. Publicación best-effort: un fallo del broker se registra y no interrumpe la operación.&lt;br/&gt;Topics: wallet-operations (comando) y wallet-operation-results (resultado)." style="text;html=1;align=left;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;spacing=6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="30" y="700" width="980" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
