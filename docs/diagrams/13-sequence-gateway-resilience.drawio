<mxfile host="app.diagrams.net" modified="2026-10-19T00:00:00.000Z" agent="opencode" version="24.0.0" type="device">
  <diagram id="seq-gateway-13" name="Secuencia - Gateway, Eureka y Resiliencia">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1145" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Ruta completa de una petición: API Gateway, Eureka, JWT y Resiliencia (US-31, US-44 a US-46)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="222" y="0" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l-cli" value="Cliente&lt;br/&gt;(HTTP + JWT)" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-gw" value="API Gateway&lt;br/&gt;:8089" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="255" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-eu" value="Eureka&lt;br/&gt;discovery-server :8761" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#E6E6E6;strokeColor=#999999;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="470" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-svc" value="Microservicio&lt;br/&gt;(WebFlux)" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="685" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-db" value="MongoDB&lt;br/&gt;(database-per-service)" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1. Solicitud HTTP con Authorization: Bearer &lt;JWT&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.14;entryX=0.5;entryY=0.14;" parent="1" source="l-cli" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2. Discovery Locator: resolver lb://CUSTOMER-SERVICE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.23;entryX=0.5;entryY=0.23;" parent="1" source="l-gw" target="l-eu" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3. Instancia viva en Eureka (:8081, healthcheck)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.32;entryX=0.5;entryY=0.32;" parent="1" source="l-eu" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="4. Proxy de la ruta Path=/customers/** reenvía Authorization y X-Forwarded-*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.41;entryX=0.5;entryY=0.41;" parent="1" source="l-gw" target="l-svc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="5. Resource Server valida firma HS256, expiración y roles (ROLE_*), luego consulta MongoDB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.50;entryX=0.5;entryY=0.50;" parent="1" source="l-svc" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="6. Documento(s) / resultado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.59;entryX=0.5;entryY=0.59;" parent="1" source="l-db" target="l-svc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="7. 200 OK (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.68;entryX=0.5;entryY=0.68;" parent="1" source="l-svc" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="8. Respuesta al cliente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.77;entryX=0.5;entryY=0.77;" parent="1" source="l-gw" target="l-cli" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="9. Si el JWT es inválido o expirado: 401 Unauthorized" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.86;entryX=0.5;entryY=0.86;" parent="1" source="l-svc" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="10. Si el Circuit Breaker está abierto o hay timeout de 2 s: 503 Service Unavailable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.95;entryX=0.5;entryY=0.95;" parent="1" source="l-gw" target="l-cli" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Resiliencia y enrutamiento (US-44, US-45, US-46):&lt;br/&gt;- El gateway NO valida el token: solo enruta y lo propaga; cada microservicio valida el JWT como OAuth2 Resource Server.&lt;br/&gt;- Rutas: /auth/**, /customers/**, /bank-accounts/** y /debit-cards/**, /credits/**, /wallets/** y /reports/** (bank-config-repo/api-gateway.yml).&lt;br/&gt;- Resilience4j: @CircuitBreaker + @TimeLimiter (slidingWindow 10, minCalls 5, failureRate 50%, timeout 2 s) con fallback a 503 desde bank-resilience-commons.&lt;br/&gt;- Configuración centralizada en Config Server (puerto y rutas) y registro de instancias en Eureka." style="text;html=1;align=left;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;spacing=6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="192" y="815" width="760" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>