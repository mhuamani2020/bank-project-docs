        <mxCell id="m6" value="6. Respuesta JSON + cabeceras CORS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.56;entryX=0.5;entryY=0.56;" parent="1" source="l-gateway" target="l-cliente" edge="1">
