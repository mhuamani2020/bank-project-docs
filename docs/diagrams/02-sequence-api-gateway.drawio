        <mxCell id="m1" value="1. HTTP GET /customers/{id}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.16;entryX=0.5;entryY=0.16;" parent="1" source="l-cliente" target="l-gateway" edge="1">
