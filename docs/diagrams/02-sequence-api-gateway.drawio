        <mxCell id="m4" value="4. Proxy de la petición con WebClient (LoadBalancer)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.40;entryX=0.5;entryY=0.40;" parent="1" source="l-gateway" target="l-svc" edge="1">
