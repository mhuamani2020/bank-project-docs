        <mxCell id="m7" value="7. (CircuitBreaker abierto / servicio caído) → Fallback: HTTP 503 ServiceUnavailableException" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.72;entryX=0.5;entryY=0.72;" parent="1" source="l-gateway" target="l-cliente" edge="1">
