        <mxCell id="note1" value="Patrones de ruta en el Gateway:&lt;br/&gt;- /customers/** → customer-service:8081&lt;br/&gt;- /bank-accounts/** → bank-account-service:8082&lt;br/&gt;- /credits/** → credit-service:8083&lt;br/&gt;Descubrimiento vía Eureka (LoadBalancer), CORS habilitado," style="text;html=1;align=left;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;spacing=6;fontSize=11;" parent="1" vertex="1">
