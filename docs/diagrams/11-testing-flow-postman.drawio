<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-10-16T00:00:00.000Z" agent="opencode" version="24.0.0" type="device">
  <diagram id="flow-testing-11" name="Flujo de pruebas - Postman E2E">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Flujo de pruebas manuales end-to-end con Postman (Partes I, II y III)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="120" y="10" width="760" height="30" as="geometry" />
        </mxCell>

        <mxCell id="prep" value="&lt;b&gt;PREPARACIÓN DEL ENTORNO&lt;/b&gt;&lt;br&gt;• Infraestructura: MongoDB (27017), Redis (6379), Kafka (9092)&lt;br&gt;• Plataforma: config-server (8888), discovery-server (8761)&lt;br&gt;• Servicios: auth (8084), customer (8081), bank-account (8082), credit (8083), yanki (8085) y api-gateway (8089)&lt;br&gt;• Alternativa: &lt;code&gt;docker compose up -d --build&lt;/code&gt;&lt;br&gt;• Verificar Eureka: http://localhost:8761 (microservicios y gateway registrados)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="60" width="880" height="130" as="geometry" />
        </mxCell>

        <mxCell id="auth" value="&lt;b&gt;FASE 0 — Autenticación&lt;/b&gt;  (carpeta «0. Auth Service»)&lt;br&gt;• &lt;b&gt;POST /auth/login&lt;/b&gt; (admin / admin123) → 200 + JWT → el script guarda &lt;b&gt;{{token}}&lt;/b&gt;&lt;br&gt;• POST /auth/register → 201 (usuario duplicado → 400)&lt;br&gt;• Toda la colección envía &lt;code&gt;Authorization: Bearer {{token}}&lt;/code&gt;&lt;br&gt;• El token va por el gateway y cada servicio lo valida (OAuth2 Resource Server)&lt;br&gt;• &lt;b&gt;Ejecutar SIEMPRE primero&lt;/b&gt; (sin token, el resto responde 401)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="220" width="880" height="130" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="&lt;b&gt;FASE 1 — Clientes&lt;/b&gt;  (carpeta «1. Customer Service»)&lt;br&gt;• POST /customers ×3 (Personal, Business, Personal VIP) → 201&lt;br&gt;• GET /customers (FindAll) · GET /customers/{id} → 200&lt;br&gt;• GET /customers/inexistente-999 → &lt;b&gt;404&lt;/b&gt; (escenario de error)&lt;br&gt;• Destino: customer-service → MongoDB customer_db (+ caché Redis)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="380" width="880" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cred" value="&lt;b&gt;FASE 2 — Créditos&lt;/b&gt;  (carpeta «2. Credit Service»)&lt;br&gt;• POST /credits: personal (solo 1; duplicado → 400), empresarial múltiple, tarjeta de crédito para VIP → 201&lt;br&gt;• Regla: un personal no puede crear crédito empresarial → &lt;b&gt;400&lt;/b&gt;&lt;br&gt;• GET /credits/customer/{id}/has-credit-card → 200 (verificación interna)&lt;br&gt;• Depende de los clientes de la FASE 1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="530" width="880" height="120" as="geometry" />
        </mxCell>

        <mxCell id="acc" value="&lt;b&gt;FASE 3 — Cuentas bancarias&lt;/b&gt;  (carpeta «3. Bank Account Service»)&lt;br&gt;• POST /bank-accounts: ahorro personal; duplicado → 400; ahorro/plazo empresarial → 400; corrientes múltiples;&lt;br&gt;&amp;nbsp;&amp;nbsp;VIP sin tarjeta → 400; VIP con tarjeta → 201; cliente inexistente → 400; plazo fijo personal&lt;br&gt;• GET /bank-accounts/{id}/balance → 200 ; inexistente → 404&lt;br&gt;• &lt;b&gt;Cross-service&lt;/b&gt; (REST + circuit breaker 2 s): valida cliente en customer-service y tarjeta en credit-service" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="680" width="880" height="140" as="geometry" />
        </mxCell>

        <mxCell id="mov" value="&lt;b&gt;FASE 4 — Movimientos y transferencias&lt;/b&gt;  (carpeta «4. Transactions &amp;amp; Transfers»)&lt;br&gt;• POST /bank-accounts/{id}/transactions: depósito, retiro (éxito) y retiro sin saldo → &lt;b&gt;400&lt;/b&gt;&lt;br&gt;• POST /bank-accounts/transfers (mismo cliente y terceros del mismo banco) → 201&lt;br&gt;• GET movimientos · CRUD del movimiento (GET by id, PUT, DELETE)&lt;br&gt;• Publica evento en Kafka &lt;code&gt;bank-account-transactions&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="850" width="880" height="120" as="geometry" />
        </mxCell>

        <mxCell id="pay" value="&lt;b&gt;FASE 5 — Pagos, consumos y saldos de crédito&lt;/b&gt;  (carpeta «5. Credit Payments, Card Consumption &amp;amp; Balances»)&lt;br&gt;• POST /credits/{id}/payments: tarjeta y personal; monto 0 → &lt;b&gt;400&lt;/b&gt;; pago de terceros (payerCustomerId)&lt;br&gt;• POST /credits/{id}/consumptions: tarjeta (éxito); excede el límite → 400; producto que no es tarjeta → 400&lt;br&gt;• GET available-balance · movements ; inexistente → 404&lt;br&gt;• Publica evento en Kafka &lt;code&gt;credit-movements&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="1000" width="880" height="130" as="geometry" />
        </mxCell>

        <mxCell id="deb" value="&lt;b&gt;FASE 6 — Tarjetas de débito y reportes&lt;/b&gt;  (carpeta «6. Debit Cards &amp;amp; Reports»)&lt;br&gt;• POST /debit-cards (cuenta inexistente → 400) · GET all / by id / by customer&lt;br&gt;• POST /debit-cards/{id}/payments → 200 (DEBIT_CARD_PAYMENT) · GET movimientos&lt;br&gt;• Reportes: /reports/bank-accounts/products-summary · /reports/debit-card/{id}/last-movements&lt;br&gt;&amp;nbsp;&amp;nbsp;y /reports/credits/products-summary · /reports/credit-card/{id}/last-movements" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="1160" width="880" height="130" as="geometry" />
        </mxCell>

        <mxCell id="yan" value="&lt;b&gt;FASE 7 — Monedero Yanki&lt;/b&gt;  (carpeta «7. Yanki Wallet (Kafka)»)&lt;br&gt;• POST /wallets (sin ser cliente del banco; celular duplicado → 400)&lt;br&gt;• GET /wallets · /wallets/{id} · /wallets/by-cellphone/{celular}&lt;br&gt;• POST /wallets/{id}/debit-card (asociar tarjeta) · POST /wallets/{id}/payments (pago a otro monedero por celular)&lt;br&gt;• POST /wallets/{id}/top-up y /withdraw → &lt;b&gt;202 Accepted&lt;/b&gt; (asíncrono por Kafka)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="1320" width="880" height="130" as="geometry" />
        </mxCell>

        <mxCell id="asyncnote" value="&lt;b&gt;ASÍNCRONO (Yanki · Kafka)&lt;/b&gt;&lt;br&gt;POST top-up / withdraw responde 202 y publica en &lt;code&gt;wallet-operations&lt;/code&gt;;&lt;br&gt;bank-account-service debita/abona la cuenta y publica el resultado en&lt;br&gt;&lt;code&gt;wallet-operation-results&lt;/code&gt;; yanki ajusta el saldo. Requiere Kafka en ejecución." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="1470" width="470" height="120" as="geometry" />
        </mxCell>

        <mxCell id="robnote" value="&lt;b&gt;IMPORTANTE PARA EJECUTAR&lt;/b&gt;&lt;br&gt;1. El &lt;i&gt;id&lt;/i&gt; de cada recurso lo genera MongoDB: copiar el id devuelto a la variable de colección correspondiente (solo {{token}} se guarda solo).&lt;br&gt;2. La colección apunta directo a cada servicio; para probar a través del gateway usar http://localhost:8089." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="550" y="1470" width="390" height="120" as="geometry" />
        </mxCell>

        <mxCell id="fin" value="&lt;b&gt;FIN — Revisar resultados&lt;/b&gt;&lt;br&gt;Cada petición trae la pestaña &lt;b&gt;Tests&lt;/b&gt; con la validación del código esperado (200 / 201 / 202 / 400 / 404).&lt;br&gt;En Yanki, esperar el evento Kafka antes de reconsultar el saldo." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="1610" width="880" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="prep" target="auth" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="auth" target="cli" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="cli" target="cred" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="cred" target="acc" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="acc" target="mov" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="mov" target="pay" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="pay" target="deb" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="deb" target="yan" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" parent="1" source="yan" target="fin" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
