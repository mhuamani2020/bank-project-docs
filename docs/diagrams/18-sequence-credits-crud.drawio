        <mxCell id="l-cr" value="credit-service&lt;br/&gt;:8083" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="470" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-cs" value="customer-service&lt;br/&gt;:8081" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="685" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-db" value="MongoDB&lt;br/&gt;credit_db.credits" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="l-kafka" value="Kafka&lt;br/&gt;credit-movements" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1115" y="40" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1. POST /credits {customerId, creditType, amount}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.11;entryX=0.5;entryY=0.11;" parent="1" source="l-cli" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2. Enrutamiento Path=/credits/** con JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.16;entryX=0.5;entryY=0.16;" parent="1" source="l-gw" target="l-cr" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3. GET /customers/{id} (WebClient + CircuitBreaker 2 s)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.22;entryX=0.5;entryY=0.22;" parent="1" source="l-cr" target="l-cs" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="4. Cliente encontrado / vacío si 404 → 400 El cliente no existe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.28;entryX=0.5;entryY=0.28;" parent="1" source="l-cs" target="l-cr" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="5. hasOverdueDebt: overdueAmount &gt; 0 → 400 (bloqueo por deuda vencida)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.33;entryX=0.5;entryY=0.33;" parent="1" source="l-cr" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="6. Reglas: PERSONAL con máximo 1 PERSONAL_CREDIT; BUSINESS no PERSONAL_CREDIT; PERSONAL no BUSINESS_CREDIT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.39;entryX=0.5;entryY=0.39;" parent="1" source="l-cr" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="7. save en credit_db.credits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.44;entryX=0.5;entryY=0.44;" parent="1" source="l-cr" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="8. 201 Created (BankAccountResponse del crédito)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.50;entryX=0.5;entryY=0.50;" parent="1" source="l-cr" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="9. JSON del crédito creado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.56;entryX=0.5;entryY=0.56;" parent="1" source="l-gw" target="l-cli" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="10. POST /credits/{id}/consumptions {amount} (solo CREDIT_CARD y amount &lt;= balance)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.61;entryX=0.5;entryY=0.61;" parent="1" source="l-cli" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="11. Descuenta el balance y guarda el movimiento CONSUMPTION" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.67;entryX=0.5;entryY=0.67;" parent="1" source="l-cr" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="12. Publica el movimiento (best-effort)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.73;entryX=0.5;entryY=0.73;" parent="1" source="l-cr" target="l-kafka" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="13. 201 con el balance actualizado / 400 si excede el límite" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.78;entryX=0.5;entryY=0.78;" parent="1" source="l-cr" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m14" value="14. POST /credits/{id}/payments {amount} → min(balance + amount, monto contratado)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.84;entryX=0.5;entryY=0.84;" parent="1" source="l-cli" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m15" value="15. Guarda el movimiento PAYMENT y publica en credit-movements → 201" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.89;entryX=0.5;entryY=0.89;" parent="1" source="l-cr" target="l-db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m16" value="16. GET available-balance (200 / 404), GET movements (200) y has-credit-card / has-overdue-debt (200)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.95;entryX=0.5;entryY=0.95;" parent="1" source="l-cr" target="l-gw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Endpoints cubiertos: CRUD de /credits (GET 200, POST 201, GET/{id} 200/404, PUT 200/404, DELETE 204), POST payments (201 / 400), POST consumptions (201 / 400), GET available-balance (200 / 404), GET /credits/{id}/movements (200) y CRUD de /credits/movements (201/200/404/204).&lt;br/&gt;- has-overdue-debt y has-credit-card son los endpoints que invoca bank-account-service para validar la creación de cuentas (US-23, US-24, US-32).&lt;br/&gt;- Pago de terceros (US-33): el movimiento PAYMENT guarda payerCustomerId; reportes de créditos → diagrama 20." style="text;html=1;align=left;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;spacing=6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="300" y="815" width="760" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>