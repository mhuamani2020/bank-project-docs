        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="b2" target="b3" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
