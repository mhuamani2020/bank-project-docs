  <diagram id="seq-credit-05" name="Secuencia - Credit Service">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Diagrama de Secuencia - credit-service (:8083, MongoDB) - Créditos y Tarjetas" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="180" y="0" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l-cliente" value="Cliente&lt;br/&gt;(HTTP / REST)" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="100" y="40" width="140" height="700" as="geometry" />
        </mxCell>
        <mxCell id="l-gateway" value="API Gateway&lt;br/&gt;:8089" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="380" y="40" width="140" height="700" as="geometry" />
        </mxCell>
        <mxCell id="l-credit" value="credit-service&lt;br/&gt;:8083 (WebFlux)" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="660" y="40" width="150" height="700" as="geometry" />
        </mxCell>
        <mxCell id="l-mongo" value="MongoDB&lt;br/&gt;credit_db" style="shape=umlLifeline;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="940" y="40" width="150" height="700" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1. POST /credits (tipo: PERSONAL_CREDIT, BUSINESS_CREDIT o CREDIT_CARD)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.14;entryX=0.5;entryY=0.14;" parent="1" source="l-cliente" target="l-gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2. Enrutamiento /credits/** → credit-service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.21;entryX=0.5;entryY=0.21;" parent="1" source="l-gateway" target="l-credit" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3. Validar datos y persistir crédito / tarjeta con límite de crédito" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.28;entryX=0.5;entryY=0.28;" parent="1" source="l-credit" target="l-mongo" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="4. Crédito / tarjeta creado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.35;entryX=0.5;entryY=0.35;" parent="1" source="l-mongo" target="l-credit" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="5. 201 Created (DTO crédito / tarjeta)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.42;entryX=0.5;entryY=0.42;" parent="1" source="l-credit" target="l-gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="6. Respuesta JSON al cliente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.49;entryX=0.5;entryY=0.49;" parent="1" source="l-gateway" target="l-cliente" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="7. POST /cards/{id}/purchases (consumo contra el límite de crédito)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.56;entryX=0.5;entryY=0.56;" parent="1" source="l-cliente" target="l-gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="8. Registrar consumo y descontar del disponible" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.63;entryX=0.5;entryY=0.63;" parent="1" source="l-gateway" target="l-credit" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="9. Actualizar saldo disponible y movimientos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.70;entryX=0.5;entryY=0.70;" parent="1" source="l-credit" target="l-mongo" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="10. Movimiento registrado (201)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.77;entryX=0.5;entryY=0.77;" parent="1" source="l-mongo" target="l-credit" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="11. Respuesta al cliente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.84;entryX=0.5;entryY=0.84;" parent="1" source="l-credit" target="l-gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="12. GET /cards/{id}/available-credit (saldo disponible) y GET /cards/{id}/movements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.91;entryX=0.5;entryY=0.91;" parent="1" source="l-cliente" target="l-gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="Operaciones clave del servicio:&lt;br/&gt;- Crear / consultar créditos (PERSONAL_CREDIT, BUSINESS_CREDIT, CREDIT_CARD)&lt;br/&gt;- Consumos de tarjeta contra el límite de crédito y pagos del crédito&lt;br/&gt;- Consulta de saldo disponible y de movimientos&lt;br/&gt;- Expone validación de tarjeta a bank-account-service (VIP / PYME)&lt;br/&gt;- Fallback: ServiceUnavailableException → HTTP 503 | Actuator: /actuator/health" style="text;html=1;align=left;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;spacing=6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="380" y="760" width="680" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
