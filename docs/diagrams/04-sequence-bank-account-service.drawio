        <mxCell id="m1" value="1. POST /bank-accounts (tipo de cuenta, idCliente)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.16;entryX=0.5;entryY=0.16;" parent="1" source="l-cliente" target="l-gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2. Enrutamiento /bank-accounts/** → bank-account-service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.24;entryX=0.5;entryY=0.24;" parent="1" source="l-gateway" target="l-account" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3. CustomerClientAdapter: GET /customers/{id} (validar cliente existente)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.32;entryX=0.5;entryY=0.32;" parent="1" source="l-account" target="l-customer" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="4. 200 OK (cliente válido) / 404 Not Found" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.40;entryX=0.5;entryY=0.40;" parent="1" source="l-customer" target="l-account" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="5. (Solo VIP / PYME) CreditClientAdapter: validar tarjeta de crédito" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.48;entryX=0.5;entryY=0.48;" parent="1" source="l-account" target="l-credit" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="6. 200 OK (posee tarjeta) / 404 Not Found" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.56;entryX=0.5;entryY=0.56;" parent="1" source="l-credit" target="l-account" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="7. Persistir cuenta aplicando reglas de producto (saldo inicial, comisiones, titulares/firmantes)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;verticalAlign=bottom;exitX=0.5;exitY=0.65;entryX=0.5;entryY=0.65;" parent="1" source="l-account" target="l-mongo" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="8. Cuenta creada (id, numeroCuenta, tipo)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.73;entryX=0.5;entryY=0.73;" parent="1" source="l-mongo" target="l-account" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="9. 201 Created (DTO de la cuenta)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.81;entryX=0.5;entryY=0.81;" parent="1" source="l-account" target="l-gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="10. Respuesta JSON al cliente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.89;entryX=0.5;entryY=0.89;" parent="1" source="l-gateway" target="l-cliente" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="11. Fallback (Resilience4j): si customer-service o credit-service no responden → ServiceUnavailableException → HTTP 503" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;exitX=0.5;exitY=0.95;entryX=0.5;entryY=0.95;" parent="1" source="l-account" target="l-gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="Reglas de producto y flujos adicionales:&lt;br/&gt;- SAVINGS: sin comisión, límite mensual de movimientos (exceso → comisión)&lt;br/&gt;- CURRENT: comisión de mantenimiento, sin límite de movimientos&lt;br/&gt;- FIXED_TERM: sin comisión, un único movimiento (retiro/depósito) por día del mes&lt;br/&gt;- Transferencias: TRANSFER_OUT (origen) + TRANSFER_IN (destino), movimientos DEPOSIT / WITHDRAWAL&lt;br/&gt;- Cuentas empresariales: uno o más titulares y cero o más firmantes autorizados" style="text;html=1;align=left;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;spacing=6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="670" width="1050" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
